<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.6-c017 91.164464, 2020/06/15-10:20:05        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <pdf:Producer>Acrobat Distiller 19.0 (Windows)</pdf:Producer>
         <pdf:Keywords>The NCP708 is a Very Low Dropout Regulator which provides up to&#xD;&#xA;1 A of load current and maintains excellent output voltage accuracy of&#xD;&#xA;1.5% including line, load and temperature variations. The operating&#xD;&#xA;input voltage range from 2.4 V up to 5.5 V makes this device suitable&#xD;&#xA;for Liâˆ’ion battery powered products as well as postâˆ’regulation&#xD;&#xA;applications. The product is available in 3.3 V fixed output voltage&#xD;&#xA;option. Other voltage options are possible on request. NCP708 is fully&#xD;&#xA;protected against overheating and output short circuit.&#xD;&#xA;Small 6âˆ’pin UDFN6 3x3 package makes the device especially&#xD;&#xA;suitable for space constrained applications.</pdf:Keywords>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2020-10-20T12:24:57+02:00</xmp:ModifyDate>
         <xmp:CreateDate>2019-10-09T12:21:05+08:00</xmp:CreateDate>
         <xmp:MetadataDate>2020-10-20T12:24:57+02:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Voltage Regulator - 1% Precision Very Low Dropout, Enable 1 A</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>The NCP708 is a Very Low Dropout Regulator which provides up to</rdf:li>
               <rdf:li>1 A of load current and maintains excellent output voltage accuracy of</rdf:li>
               <rdf:li>1.5% including line</rdf:li>
               <rdf:li>load and temperature variations. The operating</rdf:li>
               <rdf:li>input voltage range from 2.4 V up to 5.5 V makes this device suitable</rdf:li>
               <rdf:li>for Liâˆ’ion battery powered products as well as postâˆ’regulation</rdf:li>
               <rdf:li>applications. The product is available in 3.3 V fixed output voltage</rdf:li>
               <rdf:li>option. Other voltage options are possible on request. NCP708 is fully</rdf:li>
               <rdf:li>protected against overheating and output short circuit.</rdf:li>
               <rdf:li>Small 6âˆ’pin UDFN6 3x3 package makes the device especially</rdf:li>
               <rdf:li>suitable for space constrained applications.</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <xmpMM:DocumentID>uuid:f9e2a55f-54ab-43b9-a692-916bba40779a</xmpMM:DocumentID>
